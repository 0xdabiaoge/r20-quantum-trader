# ==============================================================================
# R20 QUANTUM TRADER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your own credentials.
# ==============================================================================

# LLM Reasoning Gateway Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.7-flash-high
LLM_REASONING_EFFORT=high

# OKX API Configuration (Can also be managed via `okx auth login`)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_IS_SIMULATED=0

# Web Dashboard Port & Host
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Notification Channel (QQ / Webhook)
NOTIFICATION_CHANNEL=qq
NOTIFICATION_TARGET_USER=your_user_id
NOTIFICATION_TARGET_SESSION=your_session_id
